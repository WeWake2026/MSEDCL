# ==============================================================================
# MSEDCL Quality Audit System - Environment Variables Configuration Template
# ==============================================================================

# Application Security
APP_SECRET_KEY=replace-with-a-long-random-secret-key-32-chars-min
MAX_UPLOAD_MB=25

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# Option A: Full Connection URI (URL-encode reserved characters such as @ or %)
# ------------------------------------------------------------------------------
# Example: postgresql://qa_app:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/qa_dashboard
DATABASE_URL=

# ------------------------------------------------------------------------------
# Option B: Discrete Parameters (Used if DATABASE_URL is empty)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=qa_dashboard
DB_USER=qa_app
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_TIMEOUT=10

# Connection Pool Settings (PostgreSQL only)
DB_POOL_MIN=1
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# Fallback SQLite Database Path (Used only if PostgreSQL is not configured)
# ------------------------------------------------------------------------------
DATABASE_PATH=quality_audit.db

# ------------------------------------------------------------------------------
# Initial Administrative User Accounts (seeded automatically on first startup)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=qaadmin
ADMIN_PASSWORD=Msedcl@123
QUALITY_USERNAME=quality1
QUALITY_PASSWORD=Msedcl@1234
MANAGER_USERNAME=manager1
MANAGER_PASSWORD=Msedcl@1235

# ------------------------------------------------------------------------------
# Organization-Approved SMTP Email Provider Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=quality.audit@msedcl.in

# ------------------------------------------------------------------------------
# Microsoft Graph API / Modern Auth (Optional alternate email provider)
# ------------------------------------------------------------------------------
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
