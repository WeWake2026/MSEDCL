# ==============================================================================
# MSEDCL Quality Audit System - Environment Variables Configuration Template
# ==============================================================================

# Application Security
APP_SECRET_KEY=replace-with-a-long-random-secret-key-32-chars-min
MAX_UPLOAD_MB=25

# Database Configuration
# Provide DATABASE_URL for PostgreSQL (Render, Supabase, Neon, AWS RDS, Local Docker)
# Example: postgresql://username:password@localhost:5432/msedcl_qa
DATABASE_URL=

# Fallback SQLite path if DATABASE_URL is not set
DATABASE_PATH=quality_audit.db

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_MIN=1
DB_POOL_MAX=10

# Initial Administrative User Accounts (seeded automatically on first startup)
ADMIN_USERNAME=qaadmin
ADMIN_PASSWORD=Msedcl@123
QUALITY_USERNAME=quality1
QUALITY_PASSWORD=Msedcl@1234
MANAGER_USERNAME=manager1
MANAGER_PASSWORD=Msedcl@1235

# Organization-Approved SMTP Email Provider Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=quality.audit@msedcl.in

# Microsoft Graph API / Modern Auth (Optional alternate email provider)
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
